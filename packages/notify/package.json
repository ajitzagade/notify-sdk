{
  "name": "@orgname/notify",
  "version": "1.0.0",
  "description": "WhatsApp Cloud API notification SDK — plug into any Node.js, React or Next.js app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "eventemitter3": "^5.0.1"
  },
  "peerDependencies": {
    "bull": "^4.x",
    "pg": "^8.x",
    "express": "^4.x || ^5.x",
    "react": "^18.x",
    "next": "^14.x || ^15.x"
  },
  "peerDependenciesMeta": {
    "bull":    { "optional": true },
    "pg":      { "optional": true },
    "express": { "optional": true },
    "react":   { "optional": true },
    "next":    { "optional": true }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/react": "^18.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
