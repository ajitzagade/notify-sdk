# Copy this to .env.local and fill in your values

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://notify:notify@localhost:5434/notify_sdk

# ── Credential encryption (tenant WhatsApp access tokens / app secrets) ──────
# Generate with: openssl rand -base64 32
NOTIFY_MASTER_KEY=
# Bump when rotating (see `pnpm rotate:master-key`). Defaults to 1.
NOTIFY_MASTER_KEY_VERSION=1
# Only set during a rotation window — the key being rotated OUT, so rows not
# yet re-encrypted to the new version can still be decrypted.
NOTIFY_MASTER_KEY_PREVIOUS=

# ── Admin session cookies ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Vercel Blob (tenant logo storage) ───────────────────────────────────────
# From your Vercel project's Storage tab, or `vercel env pull` once linked.
BLOB_READ_WRITE_TOKEN=

# ── First admin user (used only by `pnpm seed:admin`) ───────────────────────
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-now

PORT=3012
