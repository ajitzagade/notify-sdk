# ── Meta WhatsApp Cloud API ─────────────────────────────────────────────────
# Get all of these from https://developers.facebook.com → Your App → WhatsApp
WA_ACCESS_TOKEN=your_permanent_system_user_token_here
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_VERIFY_TOKEN=choose_any_random_string_eg_myapp2026
WA_APP_SECRET=your_app_secret_from_meta_dashboard

# ── Optional: Redis for BullQueueAdapter ────────────────────────────────────
# Leave empty to use InlineQueueAdapter (no Redis needed for local dev)
REDIS_URL=redis://localhost:6379

# ── Optional: PostgreSQL for PostgresAdapter ────────────────────────────────
# Leave empty to use InMemoryAdapter (no DB needed for local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/notifydb

# ── Multi-tenant /v1/* routes (POST /v1/send etc.) ──────────────────────────
# Required only for the tenant-facing API — the single-tenant /demo/* routes
# above don't need these. Must match the admin app's NOTIFY_MASTER_KEY exactly
# (it decrypts credentials the admin app encrypted).
NOTIFY_MASTER_KEY=

# One shared token used for Meta's GET webhook verification handshake at
# /v1/webhook/whatsapp — every tenant's Meta App webhook config should be
# pointed at this one URL using this one token (inbound event processing
# after that uses each tenant's own appSecret, resolved per-request).
PLATFORM_WEBHOOK_VERIFY_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3001
